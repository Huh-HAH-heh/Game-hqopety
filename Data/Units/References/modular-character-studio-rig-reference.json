  "conversion": {
    "coordinateMapping": {
      "x": "(baseline - sourceY) * (RimClone length / baseline)",
      "y": "(centerX - sourceX) * (RimClone width / (2 * shoulderHalfWidth))",
      "z": "(baseline - sourceY) * (RimClone height / baseline)"
    },
    "symmetry": "left/right are mirrored around centerX for a stable neutral pose; source rig has asymmetric three-quarter bind poses.",
