<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Map\UnitMap\**" />
    <EmbeddedResource Remove="Map\UnitMap\**" />
    <None Remove="Map\UnitMap\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AI\Behaviac\BehaviacData\**\*.xml"
          Link="BehaviacData\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="AI\Behaviac\BehaviacData\meta\README.txt"
          Link="BehaviacData\meta\README.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SFML.Net" Version="3.0.0" />
    <ProjectReference Include="..\Vendor\BehaviacRuntime\Behaviac.Runtime.csproj" />
  </ItemGroup>

</Project>
